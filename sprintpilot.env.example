SPRINTPILOT_REPO_ROOT=/Users/nirarad/git/arnac
# Optional; defaults to ~/.pi/sprintpilot/worktrees.json.
# SPRINTPILOT_STATE_FILE=/absolute/path/to/sprintpilot-worktrees.json

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_JQL=assignee = currentUser() AND sprint in openSprints() AND statusCategory != Done ORDER BY Rank ASC
# Optional legacy company-managed projects only, for example customfield_10014.
JIRA_EPIC_LINK_FIELD=
